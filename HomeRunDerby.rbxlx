roundTitle.TextColor3 = GOLD
local roundLines = {}
for i = 1, 3 do
	roundLines[i] = makeLabel(roundPanel, "Line" .. i, UDim2.new(0.85, 0, 0, 34), UDim2.new(0.5, 0, 0, 85 + i * 42), Enum.Font.FredokaOne)
end
local roundScale = Instance.new("UIScale")
